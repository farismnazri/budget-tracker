[Unit]
Description=Personal Budget Tracker
After=network.target

[Service]
Type=simple
User=faiz
WorkingDirectory=/home/faiz/budget-tracker
Environment=PYTHONUNBUFFERED=1
Environment=HOST=0.0.0.0
Environment=PORT=5055
ExecStart=/home/faiz/budget-tracker/.venv/bin/python /home/faiz/budget-tracker/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
